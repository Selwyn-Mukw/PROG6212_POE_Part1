@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Participant Dashboard</h2>
            <p class="text-muted">
                Welcome back, @ViewBag.DisplayName!
            </p>
        </div>

        <form asp-controller="Auth" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-outline-danger">
                Logout
            </button>
        </form>
    </div>

    <div class="row">

        <!-- Browse Events -->
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Browse Events</h5>
                    <p class="card-text">
                        Explore upcoming races and find events
                        you would like to participate in.
                    </p>

                    <a asp-controller="Participant"
                       asp-action="Index"
                       class="btn btn-primary">
                        View Events
                    </a>
                </div>
            </div>
        </div>

        <!-- My Enrolments -->
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">My Enrolments</h5>
                    <p class="card-text">
                        View the events you have registered for.
                    </p>

                    <a asp-controller="Participant"
                       asp-action="MyEvents"
                       class="btn btn-primary">
                        My Enrolments
                    </a>
                </div>
            </div>
        </div>

        <!-- My Results -->
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">My Results</h5>
                    <p class="card-text">
                        View your race results and performance.
                    </p>

                    <a asp-controller="Participant"
                       asp-action="MyResults"
                       class="btn btn-primary">
                        View Results
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>