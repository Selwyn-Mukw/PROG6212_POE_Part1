@model RaceDay.Mvc.ViewModels.ProfileVm

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    <h2>My Profile</h2>
    <p class="text-muted">View your personal account information.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null || ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @(TempData["Error"] ?? ViewBag.Error)
        </div>
    }

    @if (Model != null)
    {
        <div class="card shadow-sm mt-3">
            <div class="card-body">
                <h4>@Model.FirstName @Model.LastName</h4>
                <hr />

                <p><strong>First Name:</strong> @Model.FirstName</p>
                <p><strong>Last Name:</strong> @Model.LastName</p>
                <p><strong>Email:</strong> @Model.Email</p>
                <p><strong>Phone Number:</strong> @(Model.PhoneNumber ?? "Not provided")</p>
                <p><strong>Account Type:</strong> @Model.Role</p>
                <p><strong>Member Since:</strong> @Model.CreatedAt.ToString("dd MMMM yyyy")</p>

                <a asp-controller="Profile"
                   asp-action="Edit"
                   class="btn btn-primary">
                    Edit Profile
                </a>

                <a asp-controller="Participant"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Back to Dashboard
                </a>
            </div>
        </div>
    }
</div>