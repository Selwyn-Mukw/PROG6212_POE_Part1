@model RaceDay.Mvc.ViewModels.ProfileVm

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">

    <h2>My Profile</h2>
    <p class="text-muted">View your personal account information.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null || ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @(TempData["Error"] ?? ViewBag.Error)
        </div>
    }

    @if (Model != null)
    {
        <div class="card shadow-sm mt-3">
            <div class="card-body">

                <div class="text-center mb-4">

                    @if (!string.IsNullOrEmpty(Model.ProfilePictureURL))
                    {
                        <img src="@Url.Action("Picture", "Profile")"
                             alt="Profile Picture"
                             class="rounded-circle"
                             style="width:150px; height:150px; object-fit:cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center mx-auto"
                             style="width:150px; height:150px; font-size:40px;">
                            @Model.FirstName.Substring(0, 1)@Model.LastName.Substring(0, 1)
                        </div>
                    }

                    <h4 class="mt-3">
                        @Model.FirstName @Model.LastName
                    </h4>

                </div>

                <hr />

                <p><strong>First Name:</strong> @Model.FirstName</p>

                <p><strong>Last Name:</strong> @Model.LastName</p>

                <p><strong>Email:</strong> @Model.Email</p>

                <p>
                    <strong>Phone Number:</strong>
                    @(Model.PhoneNumber ?? "Not provided")
                </p>

                <p><strong>Account Type:</strong> @Model.Role</p>

                <p>
                    <strong>Member Since:</strong>
                    @Model.CreatedAt.ToString("dd MMMM yyyy")
                </p>

                <a asp-controller="Profile"
                   asp-action="Edit"
                   class="btn btn-primary">
                    Edit Profile
                </a>

                <a asp-controller="Participant"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Back to Dashboard
                </a>

            </div>
        </div>
    }

</div>