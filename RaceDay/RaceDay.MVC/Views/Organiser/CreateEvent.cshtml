@model RaceDay.Mvc.ViewModels.CreateEventVm

@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-4">

    <h2>Create New Event</h2>
    <p class="text-muted">Enter the details of the new race event.</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <form asp-controller="Organiser"
          asp-action="CreateEvent"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <!-- Event Name -->
        <div class="mb-3">
            <label asp-for="EventName" class="form-label">
                Event Name
            </label>

            <input asp-for="EventName"
                   class="form-control"
                   placeholder="Enter event name" />

            <span asp-validation-for="EventName"
                  class="text-danger"></span>
        </div>

        <!-- Event Date -->
        <div class="mb-3">
            <label asp-for="EventDate" class="form-label">
                Event Date and Time
            </label>

            <input asp-for="EventDate"
                   type="datetime-local"
                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                   class="form-control" />

            <span asp-validation-for="EventDate"
                  class="text-danger"></span>
        </div>

        <!-- Location -->
        <div class="mb-3">
            <label asp-for="Location" class="form-label">
                Location
            </label>

            <input asp-for="Location"
                   class="form-control"
                   placeholder="Enter event location" />

            <span asp-validation-for="Location"
                  class="text-danger"></span>
        </div>

        <!-- Description -->
        <div class="mb-3">
            <label asp-for="Description" class="form-label">
                Description
            </label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="3"
                      placeholder="Describe the event"></textarea>

            <span asp-validation-for="Description"
                  class="text-danger"></span>
        </div>

        <!-- Distance -->
        <div class="mb-3">
            <label asp-for="Distance" class="form-label">
                Distance (km)
            </label>

            <input asp-for="Distance"
                   type="number"
                   step="0.01"
                   class="form-control"
                   placeholder="e.g. 5" />

            <span asp-validation-for="Distance"
                  class="text-danger"></span>
        </div>

        <!-- Event Type -->
        <div class="mb-3">
            <label asp-for="EventTypeId" class="form-label">
                Event Type
            </label>

            <select asp-for="EventTypeId"
                    asp-items="Model.EventTypes"
                    class="form-select">

                <option value="">-- Select an event type --</option>

            </select>

            <span asp-validation-for="EventTypeId"
                  class="text-danger"></span>
        </div>

        <!-- Event Banner -->
        <div class="mb-4">
            <label asp-for="BannerImage" class="form-label">
                Event Banner Image
            </label>

            <input asp-for="BannerImage"
                   type="file"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.webp" />

            <small class="text-muted">
                Upload a JPG, PNG or WebP image. Maximum size: 5 MB.
            </small>
        </div>

        <!-- Buttons -->
        <button type="submit" class="btn btn-primary">
            Create Event
        </button>

        <a asp-controller="Organiser"
           asp-action="Events"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}